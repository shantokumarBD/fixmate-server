# Server Port
PORT=5000

# Allowed Frontend URLs (Comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000,https://fixmate-client.vercel.app

# MongoDB Connection String (Atlas Cluster URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority

# JWT Signing Secret (Must match client JWT_SECRET)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_long

# Stripe API Keys (Test Mode)
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...